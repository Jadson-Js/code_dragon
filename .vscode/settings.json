{
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  },
  "files.exclude": {
    "**/generated": true,
    "**/prisma/migrations": true,
    "**/dbdiagram.txt": true,
    "**/node_modules": true,
    "**/prisma/client.ts": true,
    "**/.gitignore": true,
    "**/.prettierignore": true,
    "**/.prettierrc": true,
    "**/eslint.config.ts": true,
    "**/package-lock.json": true,
    "**/prisma.config.ts": true,
    "**/tsconfig.json": true,
    "**/dist": true,
    "**/components.json": true,
    "**/tsconfig.app.json": true,
    "**/tsconfig.node.json": true,
    "**/vite.config.ts": true,
    "**/docker-compose.yaml": true,
    "**/Dockerfile": true,
    "**/.docker": true,
    "**/eslint.config.js": true,
    "**/scripts": true,
    "**/.dockerignore": true,
    "**/docker-compose.yml": true,
    "**/nginx": true,
    "**/.env": true,
    "**/package.json": true,
    "**/@types": true,
    "**/seed.ts": true,
    "**/public": true
  }
}
