// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SessionQuizStatus {
  GENERATING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SessionQuizRoadmapPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tokens         Token[]
  profile        Profile?
  sessions       Session[]
  sessionQuizzes SessionQuiz[]
  feedbacks      Feedback[]

  @@map("users")
}

model Token {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("tokens")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  linkedinUrl       String?  @map("linkedin_url")
  githubUrl         String?  @map("github_url")
  portfolioUrl      String?  @map("portfolio_url")
  ageRangeId        Int?     @map("age_range_id")
  seniorityId       Int?     @map("seniority_id")
  specialtyId       Int?     @map("specialty_id")
  careerObjectiveId Int?     @map("career_objective_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  ageRange        AgeRange?        @relation(fields: [ageRangeId], references: [id])
  seniority       Seniority?       @relation(fields: [seniorityId], references: [id])
  specialty       Specialty?       @relation(fields: [specialtyId], references: [id])
  careerObjective CareerObjective? @relation(fields: [careerObjectiveId], references: [id])
  stacks          ProfileStack[]

  @@map("profiles")
}

model AgeRange {
  id        Int      @id @default(autoincrement())
  name      String
  startAge  Int      @map("start_age")
  endAge    Int      @map("end_age")
  slug      String   @unique
  order     Int      @unique @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  profiles Profile[]

  @@map("age_ranges")
}

model Seniority {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  order       Int      @unique @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  profiles       Profile[]
  sessionQuizzes SessionQuiz[]

  @@map("seniorities")
}

model CareerObjective {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  order       Int      @unique @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  profiles Profile[]

  @@map("career_objectives")
}

model Specialty {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  order       Int      @unique @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  profiles       Profile[]
  quizSubjects   QuizSpecialtySubject[]
  sessionQuizzes SessionQuiz[]

  @@map("specialties")
}

model ProfileStack {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  stackId   Int      @map("stack_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id])
  stack   Stack   @relation(fields: [stackId], references: [id])

  @@map("profile_stacks")
}

model Stack {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  profileStacks     ProfileStack[]
  sessionQuizStacks SessionQuizStack[]
  quizQuestions     QuizQuestion[]

  @@map("stacks")
}

model QuizObjective {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  sessionQuizzes SessionQuiz[]

  @@map("quiz_objectives")
}

model QuizSubject {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  specialties         QuizSpecialtySubject[]
  sessionQuizSubjects SessionQuizSubject[]
  quizQuestions       QuizQuestion[]

  @@map("quiz_subjects")
}

model QuizSpecialtySubject {
  id            Int      @id @default(autoincrement())
  specialtyId   Int      @map("specialty_id")
  quizSubjectId Int      @map("quiz_subject_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  specialty   Specialty   @relation(fields: [specialtyId], references: [id])
  quizSubject QuizSubject @relation(fields: [quizSubjectId], references: [id])

  @@unique([specialtyId, quizSubjectId])
  @@map("quiz_specialty_subject")
}

model QuizQuestion {
  id                      String   @id @default(uuid())
  sessionQuizId           String?  @map("session_quiz_id")
  statement               String
  alternatives            String[]
  correctAlternativeIndex Int      @map("correct_alternative_index")
  code                    String?
  likes                   Int      @default(0)
  dislikes                Int      @default(0)
  stackId                 Int?     @map("stack_id")
  subjectId               Int?     @map("subject_id")
  seniorityId             Int      @map("seniority_id")
  specialtyId             Int      @map("specialty_id")
  objectiveId             Int      @map("objective_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  sessionQuiz SessionQuiz? @relation(fields: [sessionQuizId], references: [id])
  stack       Stack?       @relation(fields: [stackId], references: [id])
  subject     QuizSubject? @relation(fields: [subjectId], references: [id])

  @@map("quiz_questions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  featureId Int      @map("feature_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id])
  feature        Feature       @relation(fields: [featureId], references: [id])
  sessionQuizzes SessionQuiz[]
  feedbacks      Feedback[]

  @@map("sessions")
}

model SessionQuiz {
  id                String            @id @default(uuid())
  sessionId         String            @map("session_id")
  userId            String            @map("user_id")
  seniorityId       Int               @map("seniority_id")
  specialtyId       Int               @map("specialty_id")
  quizObjectiveId   Int               @map("quiz_objective_id")
  quantityQuestions Int               @map("quantity_questions")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  status            SessionQuizStatus @default(GENERATING)

  session       Session              @relation(fields: [sessionId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  seniority     Seniority            @relation(fields: [seniorityId], references: [id])
  specialty     Specialty            @relation(fields: [specialtyId], references: [id])
  quizObjective QuizObjective        @relation(fields: [quizObjectiveId], references: [id])
  questions     QuizQuestion[]
  stacks        SessionQuizStack[]
  subjects      SessionQuizSubject[]
  result        SessionQuizResult?
  roadmaps      SessionQuizRoadmap[]

  @@map("session_quizzes")
}

model SessionQuizStack {
  id            String   @id @default(uuid())
  quizSessionId String   @map("quiz_session_id")
  stackId       Int      @map("stack_id")
  score         Int?
  averageScore  Int?     @map("average_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessionQuiz SessionQuiz @relation(fields: [quizSessionId], references: [id])
  stack       Stack       @relation(fields: [stackId], references: [id])

  @@unique([quizSessionId, stackId])
  @@map("session_quiz_stacks")
}

model SessionQuizSubject {
  id            String   @id @default(uuid())
  quizSessionId String   @map("quiz_session_id")
  subjectId     Int      @map("subject_id")
  score         Int?
  averageScore  Int?     @map("average_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessionQuiz SessionQuiz @relation(fields: [quizSessionId], references: [id])
  subject     QuizSubject @relation(fields: [subjectId], references: [id])

  @@unique([quizSessionId, subjectId])
  @@map("session_quiz_subjects")
}

model SessionQuizResult {
  id             String   @id @default(uuid())
  quizSessionId  String   @unique @map("quiz_session_id")
  score          Int
  averageScore   Int      @map("average_score")
  title          String
  description    String
  strongPoints   String[] @map("strong_points")
  weakPoints     String[] @map("weak_points")
  correctAnswers Int      @map("correct_answers")
  wrongAnswers   Int      @map("wrong_answers")
  ignoredAnswers Int      @map("ignored_answers")
  ranking        Int
  percentile     Int      @map("percentile")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  sessionQuiz SessionQuiz @relation(fields: [quizSessionId], references: [id])

  @@map("session_quiz_results")
}

model SessionQuizRoadmap {
  id            String                     @id @default(uuid())
  quizSessionId String                     @map("quiz_session_id")
  title         String
  description   String
  priority      SessionQuizRoadmapPriority
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @default(now()) @updatedAt @map("updated_at")

  sessionQuiz SessionQuiz @relation(fields: [quizSessionId], references: [id])

  @@map("session_quiz_roadmaps")
}

model Feature {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  sessions  Session[]
  feedbacks Feedback[]

  @@map("features")
}

model Feedback {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  featureId   Int?      @map("feature_id")
  sessionId   String?   @map("session_id")
  rate        Int
  reason      String
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user    User     @relation(fields: [userId], references: [id])
  feature Feature? @relation(fields: [featureId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@map("feedbacks")
}
