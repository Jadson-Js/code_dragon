// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  birthDate    DateTime?  @map("birth_date")
  verifiedAt   DateTime?  @map("verified_at")
  linkedinUrl  String?    @map("linkedin_url")
  githubUrl    String?    @map("github_url")
  portfolioUrl String?    @map("portfolio_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  tokens       Token[]
  userSetup    UserSetup?

  @@map("users")
}

model Token {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("tokens")
}

model UserSetup {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  seniorityId       Int      @map("seniority_id")
  specialityId      Int      @map("speciality_id")
  careerObjectiveId Int      @map("career_objective_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  seniority       Seniority        @relation(fields: [seniorityId], references: [id])
  speciality      speciality       @relation(fields: [specialityId], references: [id])
  careerObjective CareerObjective  @relation(fields: [careerObjectiveId], references: [id])
  stacks          UserSetupStack[]

  @@map("user_setups")
}

model Seniority {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userSetups UserSetup[]

  @@map("seniorities")
}

model CareerObjective {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userSetups UserSetup[]

  @@map("career_objectives")
}

model speciality {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userSetups UserSetup[]

  @@map("specialities")
}

model UserSetupStack {
  id          String   @id @default(uuid())
  userSetupId String   @map("user_setup_id")
  stackId     Int      @map("stack_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  userSetup UserSetup @relation(fields: [userSetupId], references: [id])
  stack     Stack     @relation(fields: [stackId], references: [id])

  @@map("user_setup_stacks")
}

model Stack {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userSetupStacks UserSetupStack[]

  @@map("stacks")
}

view UserSetupView {
  userId              String   @unique @map("user_id")
  userName            String   @map("user_name")
  userSetupId         String?  @map("user_setup_id")
  seniorityName       String?  @map("seniority_name")
  specialityName      String?  @map("speciality_name")
  careerObjectiveName String?  @map("career_objective_name")
  stackNames          String[] @map("stack_names")

  @@map("user_setup_view")
}
